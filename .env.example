# Copy to .env for `make run`. Never commit .env. All values below are placeholders.

# Required: 32 random bytes, base64. Generate with: openssl rand -base64 32
RELAY_ENCRYPTION_KEY=

# Enables the Telegram channel. Get a token from @BotFather.
RELAY_TELEGRAM_BOT_TOKEN=

# Optional (defaults shown)
# RELAY_TELEGRAM_API_URL=https://api.telegram.org
# RELAY_ADDR=:8080
# RELAY_DB_PATH=./data/relay.db
# RELAY_WORKER_POLL_INTERVAL=1s
# RELAY_LOG_LEVEL=info
# RELAY_RETENTION_DAYS=30
# RELAY_METRICS_ADDR=127.0.0.1:9090
# RELAY_PPROF=false
# RELAY_MAX_BODY_BYTES=7340032
# Username or alias that may send /invite, /newkey, /keys and /revoke to the bot from their linked chat (off when empty):
# RELAY_ADMIN_RECIPIENT=admin
# Behind a reverse proxy that sets X-Forwarded-For (compose sets this):
# RELAY_TRUST_FORWARDED_FOR=false
# Host port nginx proxies to (compose only; must match deploy/nginx-relay.conf):
# RELAY_HOST_PORT=18080

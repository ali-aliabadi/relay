# Public entry point. Only the API is proxied; /metrics lives on Relay's
# internal listener and is not reachable from here. No access log: request
# lines would add little, and Relay already logs every request without content.
relay.alialiabadi.ir {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy relay:8080
}
